// 웹 버전(PWA)을 Cloudflare Workers 정적 자산으로 배포한다 — https://jumpprogrammer.app
// 서버 코드 없이 npm run build:web 결과(dist/)만 올린다. 배포는 .github/workflows/deploy-web.yml (docs/WEB.md 참고)
{
  "name": "to-jump-programmer",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    // 화면마다 index.html 이 있으므로(scripts/web-routes.ts), 없는 경로는 404 상태와 함께 앱 셸(404.html)을 내려 준다.
    // 앱은 그대로 열리고(없는 화면 안내), 검색엔진은 없는 주소를 색인하지 않는다
    "not_found_handling": "404-page"
  },
  // 도메인(Cloudflare 에 등록된 jumpprogrammer.app)에 연결한다. DNS 레코드와 인증서는 Cloudflare 가 만든다
  "routes": [{ "pattern": "jumpprogrammer.app", "custom_domain": true }],
  // *.workers.dev 주소로는 공개하지 않는다 (같은 내용이 두 주소로 색인되지 않게)
  "workers_dev": false
}
