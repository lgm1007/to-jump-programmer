# 로컬 환경 변수 예시 — 이 파일을 .env.local 로 복사해 값을 채우세요.
# .env.local 은 .gitignore 대상이라 저장소에 올라가지 않습니다.
# 스토어 빌드(EAS Build)는 이 파일이 아니라 EAS 환경 변수를 씁니다. (docs/RELEASE.md 참고)

# Google AdMob — 비워 두면 Google 공식 테스트 ID 로 동작합니다.
# 개발 빌드는 값을 넣어도 항상 테스트 광고를 사용합니다.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_BANNER_ID=
ADMOB_IOS_BANNER_ID=
ADMOB_ANDROID_INTERSTITIAL_ID=
ADMOB_IOS_INTERSTITIAL_ID=

# (선택) Java·C++ 채점용 실행 서버 기본 주소 — 사용자가 설정 화면에서 바꿀 수 있습니다.
EXPO_PUBLIC_RUNNER_URL=
