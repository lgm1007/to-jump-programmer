# EAS Build 업로드 제외 목록 — 이 파일이 있으면 EAS 는 .gitignore 대신 이것을 쓴다.
# .gitignore 와 같게 유지하되, 학습 데이터(src/content/data)는 git 에는 없지만 빌드에는 포함해야 하므로 제외하지 않는다.
# .gitignore 를 바꾸면 이 파일도 함께 바꿔주세요.

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# 서명 키 · 스토어 인증 정보 (EAS 가 관리하므로 저장소에 두지 않는다)
*.jks
*.keystore
*.p8
*.p12
*.key
*.cer
*.mobileprovision
credentials.json
credentials/
*service-account*.json

# 로컬 빌드 산출물 (eas build --local 등)
*.apk
*.aab
*.ipa
*.dSYM.zip

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# 환경 변수 (AdMob ID, 실행 서버 도메인 등) — 예시 파일만 커밋한다
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# python (scripts/)
__pycache__/
*.py[cod]

# 개인 도구 설정
.idea/
.claude/settings.local.json
*.log

example

# generated native folders
/ios
/android

# 학습 데이터는 반드시 업로드 (비공개 콘텐츠를 동기화한 상태로 빌드)
!/src/content/data/
