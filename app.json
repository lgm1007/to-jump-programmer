{
  "expo": {
    "name": "To Jump",
    "slug": "to-jump-programmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tojump",
    "userInterfaceStyle": "automatic",
    "description": "개발자 취업·이직 준비 앱 — 알고리즘 코딩 테스트, 코드 리뷰 테스트, 기술 면접 CS를 한 곳에서.",
    "ios": {
      "bundleIdentifier": "com.tojump.programmer",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ]
      }
    },
    "android": {
      "package": "com.leegm.tojumpprogrammer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3182F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "To Jump Programmer",
      "shortName": "To Jump",
      "lang": "ko",
      "themeColor": "#3182F6",
      "backgroundColor": "#F2F4F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#0E1013",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "맞춤형 광고를 보여드리는 데에만 사용돼요. 허용하지 않아도 모든 학습 기능을 그대로 이용할 수 있어요."
        }
      ],
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "207a64db-75ca-4106-8b42-7719d1b8e95d"
      }
    },
    "owner": "gmlee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/207a64db-75ca-4106-8b42-7719d1b8e95d"
    }
  }
}
